Host *
AddKeysToAgent yes
UseKeychain yes

# GitHub Enterprise Cloud
Host ghec.github.com
HostName github.com
User git
IdentityFile "~/.ssh/$(whoami)_comcast"

# GitHub Enterprise Server (Comcast)
Host github.comcast.com
HostName github.comcast.com
User git
IdentityFile "~/.ssh/$(whoami)"

# Public GitHub account
Host github.com
HostName github.com
User git
IdentityFile ~/.ssh/$(whoami)

# GitLab.com
Host gitlab.com
PreferredAuthentications publickey
IdentityFile ~/.ssh/gitlab_com_rsa

# Private GitLab instance
Host gitlab.company.com
PreferredAuthentications publickey
IdentityFile ~/.ssh/example_com_rsa
